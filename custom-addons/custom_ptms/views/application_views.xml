  <record model="ir.actions.server" id="action_apply_pt_system">
    <field name="name">From the system</field>
    <field name="model_id" ref="model_pt_application"/>
    <field name="type">ir.actions.server</field>
    <field name="state">code</field>
    <field name="code">action = model.check_pt_status_system()</field>
  </record>

  <record model="ir.actions.server" id="action_apply_pt_self">
    <field name="name">Submit Your Application</field>
    <field name="model_id" ref="model_pt_application"/>
    <field name="type">ir.actions.server</field>
    <field name="state">code</field>
    <field name="code">action = model.check_pt_status_self()</field>
  </record>

  <!-- Student Menus-->
  <menuitem id="menu_application" name="PT Allocation" parent="menu_student" sequence="2" groups="school.group_school_student"/>
  <menuitem id="menu_application_list" name="From System" parent="menu_application" action="action_apply_pt_system" sequence="1" groups="school.group_school_student"/>
  <menuitem id="menu_application_confirm" name="Submit your Own" parent="menu_application" action="action_apply_pt_self" sequence="2" groups="school.group_school_student"/>
  <menuitem id="menu_application_list_student" name="Allocations" parent="menu_application" action="action_all_applications_student" sequence="3" groups="school.group_school_student"/>

  <!-- Coordinator Menus-->
  <menuitem id="menu_application_coordinator" name="PT Allocation" parent="menu_coordinator" sequence="1" groups="school.group_school_administration,custom_ptms.department_coordinator"/>
