  <menuitem id="menu_application_rejected" name="Rejected" parent="menu_application_coordinator" action="action_rejected_applications" sequence="4" groups="school.group_school_administration,custom_ptms.department_coordinator"/>

  <menuitem id="menu_arrivalnote_coordinator" name="Arrival Notes" parent="menu_coordinator" action="action_applications_arrivalnote" sequence="2" groups="school.group_school_administration,custom_ptms.department_coordinator"/>
  <menuitem id="menu_summary_coordinator" name="Summary" parent="menu_coordinator" action="action_summary_applications" sequence="9" groups="school.group_school_administration,custom_ptms.department_coordinator"/>

  <!-- Teacher Menus-->
  <menuitem id="menu_application_approved_teacher" name="Assigned Students" parent="menu_teacher" action="action_approved_applications" sequence="1" groups="school.group_school_teacher,school.group_school_administration,custom_ptms.department_coordinator"/>
  <menuitem id="menu_arrivalnote_teacher" name="Arrival Notes" parent="menu_teacher" action="action_applications_arrivalnote" sequence="2" groups="school.group_school_teacher,school.group_school_administration,custom_ptms.department_coordinator"/>
  <menuitem id="menu_summary_teacher" name="Summary" parent="menu_teacher" action="action_summary_applications" sequence="8" groups="school.group_school_teacher,school.group_school_administration,custom_ptms.department_coordinator"/>

</odoo>