  <record id="action_summary_applications" model="ir.actions.act_window">
    <field name="name">Summary</field>
    <field name="res_model">pt.application</field>
    <field name="type">ir.actions.act_window</field>
    <field name="view_mode">tree</field>
    <field name="domain">[('state','=','accepted')]</field>
    <field name="view_id" ref="application_tree_summary"/>
    <field name="search_view_id" ref="application_search_view"/>
