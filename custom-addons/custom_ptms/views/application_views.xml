  <record id="action_applications_arrivalnote" model="ir.actions.act_window">
    <field name="name">Arrival Notes</field>
    <field name="res_model">pt.application</field>
    <field name="type">ir.actions.act_window</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('state','=','accepted'),('arrival_note','!=', False)]</field>
    <field name="view_id" ref="application_tree_arrivalnote"/>
    <field name="search_view_id" ref="application_search_view"/>
    <field name="context">{"search_default_academic_year_search":1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
                Submit Your Application
      </p>
    </field>
  </record>

  <record id="action_rejected_applications" model="ir.actions.act_window">
    <field name="name">Application</field>
    <field name="res_model">pt.application</field>
    <field name="type">ir.actions.act_window</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('state','=','rejected')]</field>
    <field name="view_id" ref="submit_to_confirm_tree"/>
    <field name="search_view_id" ref="application_search_view"/>
