<?xml version="1.0" ?>
<odoo>
    <record id="vacancy_search_view" model="ir.ui.view">
    <field name="name">pt.company.vacancy.search</field>
    <field name="model">pt.company.vacancy</field>
    <field name="arch" type="xml">
      <search>
        <field name="partner_id" string="Company"></field>
        <field name="state_id" string="Region"></field>
        <field name="academic_year_id"/>
        <field name="standard_id"/>
        <filter string="Current Academic Year" name="academic_year" domain="[('current_year','=',True)]"/>
      </search>
    </field>
  </record>

    <record id="company_vacancy_form" model="ir.ui.view">
            <field name="name">pt.company.vacancy.form</field>
            <field name="model">pt.company.vacancy</field>
            <field name="arch" type="xml">
                <form string="Vacancy" edit="false" create="false" delete="false" import="false">
                    <sheet>
                        <group col="4">
                            <field name="company_id" invisible="1"/>
                            <field name="is_editable" invisible="1"/>
                            <field name="partner_id"/>
                            <field name="state_id"/>
                            <field name="academic_year_id"/>
                            <field name="standard_id"/>
                            <field name="given_chances"/>
                            <field name="assigned_chances"/>
                            <field name="remaining_chances"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

    <record id="company_vacancy_tree" model="ir.ui.view">
        <field name="name">pt.company.vacancy.tree</field>
        <field name="model">pt.company.vacancy</field>
        <field name="arch" type="xml">
            <tree string="Vacancies" edit="false" create="false" delete="false" import="false">
                <field name="company_id" invisible="1"/>
                <field name="is_editable" invisible="1"/>
                <field name="partner_id"/>
                <field name="state_id"/>
                <field name="academic_year_id"/>
                <field name="standard_id"/>
                <!-- <field name="division_id"/> -->
                <field name="given_chances"/>
                <field name="assigned_chances"/>
                <field name="remaining_chances"/>
            </tree>
        </field>
    </record>

    <record id="company_vacancy_application_tree" model="ir.ui.view">
        <field name="name">pt.company.vacancy.tree</field>
        <field name="model">pt.company.vacancy</field>
        <field name="arch" type="xml">
            <tree string="Vacancies" edit="false" create="false" delete="false" import="false">
                <field name="company_id" invisible="1"/>
                <field name="is_editable" invisible="1"/>
                <field name="partner_id"/>
                <field name="state_id"/>
                <field name="academic_year_id"/>
                <field name="standard_id"/>
                <!-- <field name="division_id"/> -->
                <field name="remaining_chances"/>
                <button name="button_confirm"
                            context="{'vacancy_id': id}"
                            type="object" string="Reserve" class="oe_highlight" confirm="Are you sure you want to reserve this post?"/>
            </tree>
        </field>
    </record>

    <record id="company_vacancy" model="ir.actions.act_window">
        <field name="name">Vacancies</field>
        <field name="res_model">pt.company.vacancy</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{"search_default_academic_year":1}</field>
        <field name="view_id" ref="company_vacancy_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Vacancies
            </p>
        </field>
    </record>

    <record id="company_vacancy_application" model="ir.actions.act_window">
        <field name="name">Company Vacancies</field>
        <field name="res_model">pt.company.vacancy</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('remaining_chances', '>' , 0)]</field>
        <field name="context">{"search_default_academic_year":1}</field>
        <field name="view_id" ref="company_vacancy_application_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Vacancies
            </p>
        </field>
    </record>
    
    <menuitem id="menu_vacancies" name="Vacancies" parent="menu_company_vacancy" action="company_vacancy" sequence="2" />

</odoo>