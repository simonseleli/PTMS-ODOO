<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================ SEARCH VIEW FIRST ================ -->
    <record id="view_pt_application_search_student" model="ir.ui.view">
        <field name="name">pt.application.search.student</field>
        <field name="model">pt.place.application</field>
        <field name="arch" type="xml">
            <search>
                <filter name="all" string="All" domain="[]"/>
                <filter name="submitted" string="Under Review"
                        domain="[('state','=','submitted')]"/>
                <filter name="approved" string="Approved"
                        domain="[('state','=','approved')]"/>
                <filter name="rejected" string="Rejected"
                        domain="[('state','=','rejected')]"/>
            </search>
        </field>
    </record>

    <!-- ================ VIEWS ================ -->
    <!-- PT Places Tree (Student) -->
    <record id="view_student_pt_place_tree" model="ir.ui.view">
        <field name="name">student.pt.place.tree</field>
        <field name="model">pt.place</field>
        <field name="inherit_id" ref="view_pt_place_tree"/>
        <field name="groups_id" eval="[(6, 0, [ref('school.group_school_student')])]"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="edit">false</attribute>
                <attribute name="create">false</attribute>
                <attribute name="delete">false</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <button name="action_apply_pt_place"
                        type="object"
                        class="btn-primary"
                        string="Apply"
                        attrs="{'invisible': [('available_chances', '&lt;=', 0)]}"/>
            </xpath>
        </field>
    </record>

    <!-- PT Applications Tree (Student) -->
    <record id="view_student_pt_application_tree" model="ir.ui.view">
        <field name="name">student.pt.application.tree</field>
        <field name="model">pt.place.application</field>
        <field name="groups_id" eval="[(6, 0, [ref('school.group_school_student')])]"/>
        <field name="arch" type="xml">
            <tree decoration-danger="state == 'rejected'"
                  decoration-success="state == 'approved'"
                  decoration-warning="state == 'submitted'">
                <field name="name" string="Reference"/>
                <field name="place_id" string="Company"/>
                <field name="date"/>
                <field name="state" widget="badge" options="{
                    'classes': {
                        'draft': 'bg-secondary',
                        'submitted': 'bg-warning',
                        'approved': 'bg-success',
                        'rejected': 'bg-danger'
                    }
                }"/>
                <button name="action_view_application"
                        type="object"
                        class="btn-sm"
                        string="View"
                        icon="fa-eye"/>
            </tree>
        </field>
    </record>

    <!-- PT Application Form (Student) -->
    <record id="view_student_pt_application_form" model="ir.ui.view">
        <field name="name">student.pt.application.form</field>
        <field name="model">pt.place.application</field>
        <field name="groups_id" eval="[(6, 0, [ref('school.group_school_student')])]"/>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="place_id" readonly="1"/>
                            <field name="date" readonly="1"/>
                        </group>
                        <group>
                            <field name="state" widget="statusbar"
                                   options="{'clickable': false}" readonly="1"/>
                        </group>
                    </group>

                    <footer>
                        <button name="action_submit"
                                string="Submit Application"
                                type="object"
                                class="btn-primary"
                                attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                        <button name="action_draft"
                                string="Edit Draft"
                                type="object"
                                class="btn-secondary"
                                attrs="{'invisible': [('state', '!=', 'rejected')]}"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================ ACTIONS ================ -->
    <record id="action_student_pt_places" model="ir.actions.act_window">
        <field name="name">Available PT Places</field>
        <field name="res_model">pt.place</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_student_pt_place_tree"/>
        <field name="context">{'search_default_available': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Browse available Practical Training places
            </p>
        </field>
    </record>

    <record id="action_student_my_applications" model="ir.actions.act_window">
        <field name="name">My PT Applications</field>
        <field name="res_model">pt.place.application</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_student_pt_application_tree"/>
        <field name="search_view_id" ref="view_pt_application_search_student"/>
        <field name="domain">[('student_id.user_id', '=', uid)]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                You haven't applied to any PT places yet
            </p>
        </field>
    </record>
</odoo>