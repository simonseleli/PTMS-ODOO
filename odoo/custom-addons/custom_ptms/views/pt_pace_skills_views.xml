<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action for PT Skills -->
    <record id="action_pt_place_skills" model="ir.actions.act_window">
        <field name="name">PT Places</field>
        <field name="res_model">pt.skill</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first PT Skill
            </p>
        </field>
    </record>

        <!-- Tree View for PT Skill -->
    <record id="pt_skill_popup_tree_view" model="ir.ui.view">
        <field name="name">pt.skill.popup.tree</field>
        <field name="model">pt.skill</field>
        <field name="arch" type="xml">
            <tree string="Required Skills" create="true" >
                <field name="name"/>
                <field name="description"/>
            </tree>
        </field>
    </record>


    <!-- Form View for PT Skill -->
    <record id="pt_skill_form_view" model="ir.ui.view">
        <field name="name">pt.skill.form</field>
        <field name="model">pt.skill</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
