<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_document_tree" model="ir.ui.view">
            <field name="name">Document Tree</field>
            <field name="model">document.document</field>
            <field name="inherit_id" ref="document_management_system.view_document_tree"/>
            <field name="arch" type="xml">
                    <field name="parent_full_name" position="attributes">
                      <attribute name="invisible">1</attribute>
                    </field>
                    <field name="child_count" position="attributes">
                        <attribute name="invisible">1</attribute>
                    </field>
                    <field name="write_uid" position="attributes">
                        <attribute name="invisible">1</attribute>
                    </field>
                    <field name="write_date" position="attributes">
                        <attribute name="invisible">1</attribute>
                    </field>
            </field>
        </record>

        <record id="view_document_form" model="ir.ui.view">
            <field name="name">Document Form</field>
            <field name="model">document.document</field>
            <field name="inherit_id" ref="document_management_system.view_document_form"/>
            <field name="arch" type="xml">
                        <label for="child_ids" position="attributes">
                            <attribute name="invisible">1</attribute>
                        </label>
                        <field name="child_ids" position="attributes">
                            <attribute name="invisible">1</attribute>
                        </field>
                        <field name="parent_id" position="attributes">
                            <attribute name="invisible">1</attribute>
                        </field>
                        <field name="parent_full_name" position="attributes">
                            <attribute name="invisible">1</attribute>
                        </field>
                        <field name="write_uid" position="attributes">
                            <attribute name="invisible">1</attribute>
                        </field>
                        <field name="write_date" position="attributes">
                            <attribute name="invisible">1</attribute>
                        </field>              
            </field>
        </record>

        <record id="document_management_system.action_document_main" model="ir.actions.act_window">
            <field name="name">Resources</field>
            <field name="res_model">document.document</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="domain">[]</field>
            <field name="context" eval="{'search_default_filter_is_root':1}"/>
        </record>

        <menuitem id="menu_pt_resources_coordinator" name="Resources" parent="menu_coordinator" action="document_management_system.action_document_main" sequence="4"/>
        <menuitem id="menu_pt_resources_student" name="Resources" parent="menu_student" action="document_management_system.action_document_main" sequence="4"/>
        <menuitem id="menu_pt_resources_teacher" name="Resources" parent="menu_teacher" action="document_management_system.action_document_main" sequence="4"/>

    </data>
</odoo>
