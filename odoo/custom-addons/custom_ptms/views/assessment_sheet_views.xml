<odoo>
    <!-- ================= ACTION WINDOW ================= -->
    <record id="action_assessment_sheet" model="ir.actions.act_window">
        <field name="name">Assessment Sheets</field>
        <field name="res_model">pt.application.assessment.sheet</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('application_id', '=', active_id)]</field>
        <field name="context">{'default_application_id': active_id}</field>
    </record>

    <!-- ================= TREE VIEW ================= -->
    <record id="view_assessment_sheet_tree" model="ir.ui.view">
        <field name="name">assessment.sheet.tree</field>
        <field name="model">pt.application.assessment.sheet</field>
        <field name="arch" type="xml">
            <tree string="Assessment Sheets">
                <field name="name"/>
                <field name="total"/>
                <field name="is_final"/>
            </tree>
        </field>
    </record>

    <!-- ================= FORM VIEW ================= -->
<record id="view_assessment_sheet_form" model="ir.ui.view">
    <field name="name">assessment.sheet.form</field>
    <field name="model">pt.application.assessment.sheet</field>
    <field name="arch" type="xml">
        <form string="Assessment Sheet" create="false">
            <sheet>

                <!-- Basic Information Section -->
                <group string="ASSESSMENT SHEET">
                    <field name="application_id" options="{'no_create': True, 'no_open': True}" readonly="1"/>
                    <field name="name" readonly="1"/>
                    <field name="supervisor_id" readonly="1"/>
                    <field name="is_final"/>
                </group>

                <!-- Personnel Section -->
                <group string="Personnel">
                    <group string="Training Officer" col="2">
                        <field name="training_officer" style="width:60px"/>
                    </group>
                    <group string="Academic Supervisor" col="2">
                        <field name="academic_supervisor" style="width:60px"/>
                    </group>
                </group>

                <!-- Logbook Assessment Section -->
                <group string="Logbook Assessment - Student's Logbook (Weekly Report)" col="4">
                    <field name="logbook_content" style="width:60px"/>
                    <field name="logbook_neatness" style="width:60px; margin-bottom:50px;"/>
                    <field name="logbook_relevance" style="width:60px"/>
                    <field name="logbook_organization" style="width:60px"/>
                </group>

                <!-- Main Report Sections -->
                <group string="MAIN REPORT - The Company or Organisation" col="2">
                    <group>
                        <field name="report_intro" style="width:60px; margin-bottom:60px;"/>
                        <field name="report_safety" style="width:60px; margin-bottom:70px;"/>
                    </group>
                    <group>
                        <field name="report_job_desc" style="width:60px; margin-bottom:70px;"/>
                        <field name="report_recruitment" style="width:60px"/>
                    </group>
                </group>

                <group string="MAIN REPORT - Main Task" col="4">
                    <field name="task_diagram" style="width:60px"/>
                    <field name="task_problem" style="width:60px; margin-bottom:70px;"/>
                    <field name="task_solution" style="width:60px"/>
                    <field name="task_comparison" style="width:60px; margin-bottom:70px;"/>
                    <field name="task_technical" style="width:60px; margin-bottom:70px;"/>
                    <field name="task_conclusion" style="width:60px"/>
                    <field name="task_references" style="width:60px"/>
                    <field name="task_formatting" style="width:60px"/>
                </group>

                <!-- Total Score Section -->
                <group string="Scoring">
                    <field name="total" readonly="1"/>
                </group>

            </sheet>
        </form>
    </field>
</record>
</odoo>