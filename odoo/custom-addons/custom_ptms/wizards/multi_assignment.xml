<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="coordinator_assignment_form">
            <field name="name">pt.multiassignment.wizard.form</field>
            <field name="model">pt.multiassignment.wizard</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Assign PT Places">
                    <field name="company_id" invisible="1"/>
                    <group col="4">
                        <field name="date" readonly="1"/>
                    </group>
                    <group>
                        <field name="vacancy_id" options='{"no_create": True,"no_open": True}' domain="[('current_year','=',True),('remaining_chances','&gt;',0)]" context='{"search_default_academic_year":1}'/>
                    </group>
                    <group>
                        <field name="student_ids" widget="many2many_tags" domain="[('state','=','done')]" options='{"no_create": True,"no_open": True}' />
                    </group>
                    <footer>
                        <button class="oe_highlight" type="object" name="save_assignment" string="Save" confirm="Are you sure you wish to Continue?"/>
                        <button class="oe_highlight" special="cancel" string="Cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_multiple_assignment" model="ir.actions.act_window">
            <field name="name">Assign PT Places</field>
            <field name="res_model">pt.multiassignment.wizard</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="coordinator_assignment_form"/>
             <field name="target">new</field>
            <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                    Multiple Assignment
            </p>
            </field>
        </record>

        <menuitem id="menu_application_multiple" name="Assignment" parent="menu_application_coordinator" action="action_multiple_assignment" sequence="5" groups="school.group_school_administration,custom_ptms.department_coordinator"/>


    </data>
</odoo>