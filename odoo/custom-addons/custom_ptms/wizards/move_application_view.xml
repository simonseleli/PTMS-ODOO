<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_move_application_form" model="ir.ui.view">
        <field name="name">move_applications.form</field>
        <field name="model">move.applications</field>
        <field name="arch" type="xml">
            <form string="Move Applications">
                    <group>
                        <field name="academic_year_id" placeholder="Academic Year" widget="selection"/>
                    </group>
                    <footer>
                        <button class="btn btn-sm btn-default fa fa-ban" special="cancel" string="Close"/>
                        <button class="btn btn-sm btn-default fa fa-plus" name="move_start" string="Move" type="object"/>
                    </footer>
           </form>
        </field>
    </record>
    
    <!-- Action Of Form & Tree Views Of Move Classes -->
    <record id="action_move_applications_form" model="ir.actions.act_window">
        <field name="name">Move Applications</field>
        <field name="res_model">move.applications</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_move_application_form" />
        <field name="target">new</field>
    </record>

    <!-- MenuItem For Configurations->Move Classes -->
    <menuitem id="menu_move_application_form" name="Move Applications" parent="school.menu_configuration" action="action_move_applications_form" />

</odoo>
